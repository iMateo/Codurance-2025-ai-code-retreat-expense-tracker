{
  "name": "expense-tracker-legacy",
  "version": "1.0.0",
  "description": "Legacy expense tracking system for AI code retreat",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "build:watch": "tsc --watch",
    "test": "jest",
    "test:coverage": "jest --coverage",
    "dev": "node --loader ts-node/esm src/index.ts",
    "dev:web": "concurrently \"npm run build:watch\" \"nodemon --watch dist server.js\"",
    "lint": "eslint src/**/*.ts",
    "start": "node dist/index.js",
    "serve": "npm run build && node server.js",
    "web": "npm run build && node server.js"
  },
  "keywords": [
    "expense",
    "tracking",
    "legacy",
    "refactoring"
  ],
  "author": "Code Retreat Organizer",
  "license": "MIT",
  "devDependencies": {
    "@types/jest": "^29.5.0",
    "@types/node": "^18.15.0",
    "@types/uuid": "^9.0.0",
    "@typescript-eslint/eslint-plugin": "^5.57.0",
    "@typescript-eslint/parser": "^5.57.0",
    "concurrently": "^9.2.1",
    "eslint": "^8.37.0",
    "jest": "^29.5.0",
    "nodemon": "^3.1.11",
    "ts-jest": "^29.1.0",
    "ts-node": "^10.9.0",
    "typescript": "^5.0.0"
  },
  "dependencies": {
    "uuid": "^9.0.0"
  }
}
